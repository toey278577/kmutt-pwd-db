# systemd ของหลังบ้าน — อยู่ที่ /etc/systemd/system/kmutt-backend.service
# เปิดเครื่องแล้วรันเอง · ล่มแล้วเปิดใหม่ใน 5 วิ · ตั้งค่า (รหัสฐานข้อมูล ฯลฯ) อ่านจาก /opt/kmutt/backend/.env
[Unit]
Description=KMUTT PWD Backend
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/kmutt/backend
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
